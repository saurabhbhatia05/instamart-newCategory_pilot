# Survey PDF path (absolute or relative to project root)
SURVEY_PDF_PATH=data/survey/responses.pdf

# Grok LLM — optional Phase 2 explainability (falls back to rules if disabled)
GROK_API_KEY=
# GROQ_API_KEY=optional_fallback_key
GROK_MODEL=grok-2-latest
GROQ_MODEL=llama-3.3-70b-versatile
USE_LLM=false

# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Phase 1
RECOMMENDATION_CONFIDENCE_THRESHOLD=0.65
MAX_RECOMMENDATIONS_PER_SESSION=1
RECOMMENDATION_LATENCY_MS=500

# Phase 3
AB_TEST_ENABLED=true
AB_TEST_CONTROL_RATIO=0.5

# Phase 4
ENABLE_CONTINUOUS_LEARNING=false
KPI_MONITORING_INTERVAL_SECONDS=300
